<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluemoon.backend.mapper.TopMoverMapper">

    <resultMap id="TopMoverResultMap" type="com.bluemoon.backend.domain.stock.TopMover">
        <id column="id" property="id"/>
        <result column="stock_code" property="stockCode"/>
        <result column="rank_no" property="rankNo"/>
        <result column="change_rate" property="changeRate" javaType="java.math.BigDecimal"/>
        <result column="captured_at" property="capturedAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO top_movers (stock_code, rank_no, change_rate, captured_at)
        VALUES (#{stockCode}, #{rankNo}, #{changeRate}, #{capturedAt})
    </insert>

    <delete id="deleteAll">
        DELETE FROM top_movers
    </delete>

    <select id="findStockCodesOrderByRank" resultType="string">
        SELECT stock_code
        FROM top_movers
        ORDER BY rank_no ASC
    </select>

</mapper>
