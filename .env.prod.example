# 배포용(docker-compose.prod.yml) 환경 변수.
# cp .env.prod.example .env.prod 로 복사한 뒤 값을 채우세요.
#
# ── Oracle Cloud Autonomous Database (Always Free) 연결 ──────────
# OCI 콘솔 → Autonomous Database → 생성한 DB 클릭 → "Database Connection"에서 확인 가능.
#
# 방법 A. 지갑 없는 TLS 연결 (권장 — 볼륨 마운트/지갑 파일 관리 불필요)
#   DB를 "네트워크 액세스"에서 mTLS 필수 아님(TLS만 허용)으로 만들었다면 사용 가능.
#   "Database Connection" 팝업에서 "지갑 없는(Wallet-less) 연결"의 연결 문자열을 그대로 사용:
#
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=<host>.oraclecloud.com))(connect_data=(service_name=<db>_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
#
# 방법 B. 지갑(mTLS) 연결
#   OCI 콘솔에서 지갑(Wallet) zip 다운로드 → 압축 해제해서 이 리포지토리의 secrets/wallet/ 에 넣기
#   (secrets/는 .gitignore에 이미 포함되어 있어야 함 — 지갑 파일은 절대 커밋하지 말 것)
#
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<tns_alias>_high?TNS_ADMIN=/app/wallet
#
# 두 방법 다 username/password는 DB 생성 시 설정한 ADMIN(또는 별도 생성한 앱 유저) 계정 사용.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ── Backend (Spring Boot) ──────────────────
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=1209600000
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# ── AI 인사이트 ──────────────────────────
NEWSDATA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
